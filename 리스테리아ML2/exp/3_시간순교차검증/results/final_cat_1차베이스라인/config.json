 "score_rule": {
  "selection": "고르기 점수(바닐라 순위·k·튜닝 목표·변수 빼기·묶음 섞기 중요도) = 교차검증 세 겹 평균 구간 가중 PR-AUC = 0.5 × 평균(H1~20) + 0.3 × 평균(H21~40) + 0.2 × 평균(H41~60) (h 마다 PR-AUC)",
  "threshold_rule": "max_precision_at_recall>=0.80",
  "threshold": "판정 기준값 = 60개 h 합친 예측에서 Recall ≥ 0.80 를 지키는 기준값 가운데 Precision 이 가장 큰 값(같은 Precision 이면 Recall 이 큰 쪽), 판정 = 예측 확률 ≥ 기준값 - 겹마다 그 겹 맞혀 보는 행으로, 시험용은 세 겹 맞혀 보는 행 예측을 합친 것에서 같은 규칙",
  "wpr_auc": "겹마다 h 별 average precision(sklearn) -> 0.5 × 평균(H1~20) + 0.3 × 평균(H21~40) + 0.2 × 평균(H41~60) (검출·불검출이 다 있지 않은 h 는 그 구간 평균에서 뺌) -> 겹 평균",
  "pr_auc": "겹마다 h 별 average precision(sklearn) -> h 1..60 단순 평균 -> 겹 평균 (60일 평균 PR-AUC)",
  "p_at_r": "겹마다 그 기준값에서 60개 h 합친 Precision(= Recall ≥ 0.80 에서의 최대 Precision) -> 겹 평균",
  "wrecall": "그 기준값에서 h 마다 Recall -> 0.5 × 평균(H1~20) + 0.3 × 평균(H21~40) + 0.2 × 평균(H41~60) -> 겹 평균",
  "metrics": "Accuracy·Precision·Recall·F1·검사축소율(= 1 − (TP+FP+FN)/N)·상위 k%·ROC-AUC = 그 기준값에서 h 마다 -> h 평균 -> 겹 평균, TP·FP·FN·TN·N = h 당 평균 -> 겹 평균. 검출(또는 불검출)이 없는 h 는 PR-AUC·ROC-AUC·상위 k% 평균에서 빠짐(h_without_both_classes 에 기록)",
  "topk": "h 마다 확률 내림차순(같으면 행 순서) 상위 ceil(행 수 x k/100) 행의 검출 ÷ 그 h 검출 (k = 1·5·10·20)",
  "early_stopping": "부스팅 3종·BiLSTM: 그 겹 맞혀 보는 행 h 별 average precision 의 h 1..60 평균(빠른 계산 ap60_fast)을 매 반복(에폭), 인내 100(BiLSTM 5) - 지금 코드 그대로",
  "test": "시험: 기준값 = 세 겹 맞혀 보는 행 예측을 합친 것에서 같은 규칙. 점수 = h 1~60 평균·구간 가중, 건수 = h 당 평균",
  "past_rule": "과거 이력(품목군 3단계·시군구·단위 x 5년·1년 스무딩 검출률, log(1+검사 수), 1년 불확실성)·WOE 4개·제품명 과거 유형 N1·전국 p0: 학습 행 = 그 행 예측일 T 전날까지 굴러가는 창(기준일 ∈ [T−P, T−1], P = 365·1,826일), 맞혀 보는 행·시험 행 = 그 겹(최종) 학습 끝 날 TE 까지 시료로 만든 값(기준일 ∈ [TE−P+1, TE])을 그 해 모든 행·모든 h 에 고정(학습 끝 값 고정). 계산 = 2차 e2hist·e2nb 그대로, 맞혀 보는 행·시험 행은 h 대신 d − (TE + 1일)을 넘김"
 },
